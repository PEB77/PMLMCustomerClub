<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PMLMCustomerClub.View"
      xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="PMLMCustomerClub.View.MainPage"
      xmlns:local2="clr-namespace:PMLMCustomerClub.CustomControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="White">

    <Page.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="Purple"/>
        </Style>
        
    </Page.Resources>
    
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Background="WhiteSmoke">

            <MenuItem Header="Export"
                      x:Name="ExportMenu">
                <MenuItem x:Name="ExportProducts"
                          Header="Products"
                          Click="ExportProducts_Click"/>
                <MenuItem x:Name="ExportCustomers"
                          Header="Customers"
                          Click="ExportCustomers_Click"/>

            </MenuItem>

            <MenuItem Header="Import"
                      x:Name="ImportFile">
                <MenuItem x:Name="ImportProducts"
                          Header="Products"
                          Click="ImportProducts_Click"/>
                <MenuItem x:Name="ImportCustomers"
                          Header="Customers"
                          Click="ImportCustomers_Click"/>
            </MenuItem>
        </Menu>

        <DockPanel Grid.Row="1">

        <dx:DXTabControl x:Name="MainTabControl"
                         DockPanel.Dock="Left"
                         SelectionChanged="MainTabControl_SelectionChanged">
            <dx:DXTabControl.View>
                <dx:TabControlScrollView HeaderLocation="Left" HeaderOrientation="Vertical"/>
            </dx:DXTabControl.View>
            <dx:DXTabItem x:Name="CustomersTabHeader"
                          Header="Customers"
                          >
                <DockPanel>
                    <local2:TableViewer x:Name="CustomerTableViewer"
                                        >
                        
                    </local2:TableViewer>
                </DockPanel>
            </dx:DXTabItem>

            <dx:DXTabItem x:Name="OrdersTabHeader"
                          Header="Orders">
                <DockPanel>
                    <local2:TableViewer x:Name="OrderTableViewer"
                                        >
                        
                    </local2:TableViewer>
                </DockPanel>
            </dx:DXTabItem>

            <dx:DXTabItem x:Name="StoreTabHeader"
                          Header="Store">
                <DockPanel>
                    <local2:TableViewer x:Name="StoreTableViewer"
                                        >
                        
                    </local2:TableViewer>
                </DockPanel>
            </dx:DXTabItem>

            <dx:DXTabItem x:Name="ProductTabHeader"
                          Header="Product">
                <DockPanel>
                    <local2:TableViewer x:Name="ProductTableViewer"
                                        >
                        
                    </local2:TableViewer>
                </DockPanel>
            </dx:DXTabItem>

        </dx:DXTabControl>

    </DockPanel>
    </Grid>
</Page>
